# Web (public, safe to expose in the browser)
NEXT_PUBLIC_SHARED_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SHARED_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_DEFAULT_COMPANY=harbourline
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# HR pages need two-step sign-in. true in every deployed project; false only on the local stack.
NEXT_PUBLIC_REQUIRE_HR_MFA=true

# Edge Function secrets (set with Supabase secrets, never commit values)
SENTRY_DSN=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
# HR functions refuse sessions without two-step sign-in (AAL2). true in every deployed project.
REQUIRE_HR_MFA=true
# Where invite emails send people (the app's address), e.g. https://harbourline.example.com
SITE_URL=
# Scheduled jobs: shared secret between pg_cron (Vault secret cron_secret) and the job functions
CRON_SECRET=
# Email from functions (clock-out reminders). Without these, emails are skipped and logged as skipped.
RESEND_API_KEY=
EMAIL_FROM=

# GitHub Actions secrets (set in the repository settings, listed here for reference only)
# SUPABASE_ACCESS_TOKEN, STAGING_PROJECT_REF, STAGING_DB_PASSWORD,
# PROD_PROJECT_REFS_JSON, PROD_DB_PASSWORDS_JSON,
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID,
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_ENDPOINT, BACKUP_AGE_PUBLIC_KEY
